2026-11-01 * "Buy stock"
  Assets:Broker                 1 ACME {{ 10 USD }}
  Assets:Broker

2026-11-02 * "Sell for loss"
  Assets:Broker                -1 ACME {}
  Assets:Broker                 5 USD
  choose account {
    when direction is debit: Income:Capital-Gains:Losses,
    otherwise: Income:Capital-Gains
  }

2026-11-02 balance
  Income:Capital-Gains          0 USD
  Income:Capital-Gains:Losses   5 USD
