account-rule "long-term-gains-only" {
  when context is aggregate: break,
  when direction is debit: break,
  when holding-period >= 365d: Income:Capital-Gains:Long-Term,
  otherwise: fail "Unexpected short-term gain"
}

2025-01-01 * "Buy long-term lot"
  Assets:Broker                       1 ACME { 100 USD }
  Assets:Cash

2026-06-01 * "Buy short-term lot"
  Assets:Broker                       1 FOO  { 200 USD }
  Assets:Cash

2026-11-01 * "Sell both with EUR fee"
  Assets:Cash                        -5 EUR
  Assets:Broker                      -1 ACME {}
  Assets:Cash                       150 USD
  Assets:Broker                      -1 FOO  {}
  Assets:Cash                       180 USD
  ; Routes the long-term ACME gain; breaks on the EUR fee aggregate residual
  ; and the FOO loss (keeping its lot context pending) without hitting fail.
  choose account "long-term-gains-only"
  choose account {
    when context is reduction and holding-period < 365d and direction is debit:
      Income:Capital-Gains:Short-Term-Losses,
    when context is reduction: fail "Expected all remaining reductions to be short-term losses",
    otherwise: Expenses:Fees
  }

2026-11-02 * "Zero realized gain does not trigger fail"
  Assets:Broker                       1 BAR  { 50 USD }
  Assets:Cash                       -50 USD
  Assets:Broker                      -1 BAR  {}
  Assets:Cash                        50 USD
  choose account {
    when direction is debit: fail "Should not be evaluated",
    otherwise: fail "Should not be evaluated"
  }

2026-11-03 balance
  Income:Capital-Gains:Long-Term          -50 USD
  Income:Capital-Gains:Short-Term-Losses   20 USD
  Expenses:Fees                             5 EUR
