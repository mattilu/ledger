account-rule "strict-long-term" {
  when context is reduction and holding-period >= 365d:
    Income:Capital-Gains:Long-Term,
  otherwise: fail "Short-term or non-reduction portion not allowed"
}

2026-06-01 * "Buy stock"
  Assets:Broker  1 ACME { 100 USD }
  Assets:Cash

2026-11-01 * "Sell short-term stock"
  Assets:Broker -1 ACME {}
  Assets:Cash  120 USD
  choose account "strict-long-term"
