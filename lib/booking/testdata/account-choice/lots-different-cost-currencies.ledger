2026-11-01 * "Buy USD lot"
  Assets:Broker                     1 ACME { 10 USD }
  Assets:Cash                     -10 USD

2026-11-02 * "Buy second USD lot"
  Assets:Broker                     1 ACME { 20 USD }
  Assets:Cash                     -20 USD

2026-11-03 * "Buy EUR lot"
  Assets:Broker                     1 ACME { 15 EUR }
  Assets:Cash                     -15 EUR

2026-11-04 * "Sell all lots across cost currencies"
  Assets:Broker                    -3 ACME {}
  Assets:Cash                      28 USD
  Assets:Cash                      18 EUR
  choose account {
    when context is reduction and direction is debit: Income:Capital-Gains:Losses,
    when context is reduction and direction is credit: Income:Capital-Gains,
    otherwise: Income:Unexpected-Residual
  }

