2026-11-03 * "Sell both"
  Assets:Broker                -1 ACME {}
  Assets:Broker                15 USD
  choose account {
    ; This doesn't match, so the balance remains available.
    when direction is debit: Income:Capital-Gains:Losses
  }
  Assets:Broker                -1 FOO {}
  Assets:Broker                16 USD
  choose account {
    ; This doesn't match the remaining debit portion.
    when direction is credit: Income:Capital-Gains
  }
  choose account {
    when direction is debit: Income:Capital-Gains:Losses,
    otherwise: Income:Capital-Gains
  }

